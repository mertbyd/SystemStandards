<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>SystemStandards.Abp</PackageId>
    <Title>System Standards - ABP Framework Integration</Title>
    <Version>2.1.0</Version>
    <Authors>Mert Bayd</Authors>
    <Description>ABP Framework integration for SystemStandards. Includes Result handling, exception mapping and opt-in fail-closed selected-context authorization.</Description>
    <PackageTags>result;ardalis;abp;aspnetcore;validation;authorization;multitenancy</PackageTags>
    <RepositoryUrl>https://github.com/mertbyd/SystemStandards</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- ABP Framework packages -->
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.3.0" />
    <PackageReference Include="Volo.Abp.Authorization" Version="10.3.0" />
    <PackageReference Include="Volo.Abp.Identity.Domain.Shared" Version="10.3.0" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.3.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project References -->
    <ProjectReference Include="..\..\SystemStandards.AspNetCore\SystemStandards.AspNetCore\SystemStandards.AspNetCore.csproj" />
    <ProjectReference Include="..\..\SystemStandards.Core\SystemStandards.Core\SystemStandards.Core.csproj" />
    <ProjectReference Include="..\..\SystemStandards.Validation\SystemStandards.Validation\SystemStandards.Validation.csproj" />
  </ItemGroup>

</Project>
