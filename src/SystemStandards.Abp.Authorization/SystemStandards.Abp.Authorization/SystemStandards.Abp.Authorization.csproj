<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>SystemStandards.Abp.Authorization</PackageId>
    <Title>System Standards - Authenticator Authorization Client</Title>
    <Version>2.1.0</Version>
    <Authors>Mert Bayd</Authors>
    <Description>Drop-in tenant / organization unit / application scope authorization for ABP projects. One DependsOn and one AddAuthenticatorAuthorization call wire a fail-closed authorization client over the Authenticator decision endpoint.</Description>
    <PackageTags>authorization;abp;aspnetcore;multitenancy;fail-closed</PackageTags>
    <RepositoryUrl>https://github.com/mertbayd/SystemStandards</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTTP dayanıklılığı elle yazılmaz; standart resilience handler kullanılır. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Volo.Abp.Authorization" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SystemStandards.Abp\SystemStandards.Abp\SystemStandards.Abp.csproj" />
    <ProjectReference Include="..\..\SystemStandards.Authorization.Contracts\SystemStandards.Authorization.Contracts\SystemStandards.Authorization.Contracts.csproj" />
  </ItemGroup>

</Project>
